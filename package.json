{
  "name": "php-better-snippets",
  "displayName": "PHP Better Snippets",
  "description": "This extension provides code snippets for PHP and Symfony framework, enabling you to code faster and be more productive.",
  "version": "0.7.0",
  "author": {
    "name": "victordev",
    "url": "https://github.com/victordev13"
  },
  "publisher": "victordev",
  "main": "./dist/extension.js",
  "icon": "./images/icon.png",
  "keywords": [
    "php",
    "snippets",
    "php snippets",
    "php functions",
    "symfony",
    "symfony snippets",
    "doctrine",
    "doctrine snippets"
  ],
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "contributes": {
    "configuration": {
      "title": "PHP Better Snippets",
      "properties": {
        "php-better-snippets.enable-symfony-snippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable Symfony-related snippets (controllers, Doctrine, Messenger, Scheduler, attributes, etc.). Disable this if you only work with plain PHP projects."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node16",
    "watch": "npm run compile -- --watch",
    "vscode:prepublish": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js",
    "pack": "vsce package",
    "publish": "vsce package && vsce publish",
    "publish:pre-release": "vsce package --pre-release && vsce publish --pre-release"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.79.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "url": "https://github.com/victordev13/php-better-snippets"
  }
}
